	(gr_text "HAMMOND 1550Q: PCB REPLACES LID, MOUNTED UPSIDE DOWN: F (SMD) side faces INTO box, B is outside"
		(at 121.55 139.85 0)
		(layer "Dwgs.User")
		(uuid "45771569-2530-4842-b46e-bf9ffbb3489b")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.12)
			)
			(justify left)
		)
	)
	(gr_text "Lid screws: 4x M3.5-0.6 x 12 mm (tapped in box). Holes 4.10 mm, pitch 50.00 x 45.00 mm, 5.00 mm from the outside edges"
		(at 121.55 141.25 0)
		(layer "Dwgs.User")
		(uuid "b089ebb3-c120-41e6-83f2-9b2cea4b172a")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.12)
			)
			(justify left)
		)
	)
	(gr_text "Rim contact: F.Cu bare GND ring (F.Mask relief) is 2.63 mm on all four sides (2.13 mm wall + 0.5 mm). GND vias 0.45/0.2 mm at 3 mm pitch, centered in the ring"
		(at 121.55 142.65 0)
		(layer "Dwgs.User")
		(uuid "35e1b278-edad-4f64-bec0-5a5ef58308f1")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.12)
			)
			(justify left)
		)
	)
	(gr_text "F-side keepout: 2.63 mm rim ring and R3.0 bosses centered on H1-H4. F-side component"
		(at 121.55 144.05 0)
		(layer "Dwgs.User")
		(uuid "9e00f767-745b-474c-b228-1dba7464daf3")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.12)
			)
			(justify left)
		)
	)
	(gr_text "Inside height 26.80 mm on the 1550Q drawing (26.00 mm also shown on the side view). SMAs through-hole, exit out B (outside) face"
		(at 121.55 145.45 0)
		(layer "Dwgs.User")
		(uuid "f47d69e3-66fb-471b-bf86-97ed1de6f0c5")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.12)
			)
			(justify left)
		)
	)
	(gr_text "Jumpers inside on F side. USB-C J1 is on F.Cu, 3.5 mm inside the outline, so it does not overhang. Corner radius 5.0 mm"
